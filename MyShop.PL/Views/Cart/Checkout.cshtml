@model MyShop.PL.ViewModels.CheckoutViewModel
@using Microsoft.Extensions.Options
@using MyShop.BLL.Models.Common
@inject IOptions<StripeSettings> StripeOptions

@{
    Layout = "~/Views/Shared/_Customer.cshtml";
    ViewData["Title"] = "Checkout";

    var items = Model?.Items ?? new List<MyShop.DAL.Entities.CartItem>();
    var totalItems = items.Sum(item => item.Quantity);
    var subtotal = Model?.TotalPrice ?? items.Sum(item => item.TotalPrice);
    var shipping = 0m;
    var total = subtotal + shipping;
    var publishableKey = StripeOptions.Value?.PublishableKey ?? string.Empty;
    var stripeSecretConfigured = !string.IsNullOrWhiteSpace(StripeOptions.Value?.SecretKey);
    var stripeConfigured = !string.IsNullOrWhiteSpace(publishableKey) && stripeSecretConfigured;
    var paymentIntentUrl = Url.Action("CreatePaymentIntent", "Payment") ?? "/Payment/CreatePaymentIntent";
    var stripeEnabledValue = stripeConfigured.ToString().ToLowerInvariant();
    ViewData["LoadStripeJs"] = stripeEnabledValue;
}

<section class="checkout-page">
    <div class="store-container">
        <div class="checkout-hero store-fade-in">
            <div class="checkout-hero-copy">
                <span class="section-eyebrow"><i class="fas fa-lock"></i> Secure Checkout</span>
                <h1>Confirm your delivery details.</h1>
                <p>Add the address and phone number for this order. Your cart items will be converted into a saved customer order.</p>

                <div class="checkout-trust-row" aria-label="Checkout benefits">
                    <span><i class="fas fa-shipping-fast"></i> Fast Delivery</span>
                    <span><i class="fas fa-shield-alt"></i> Secure Checkout</span>
                    <span><i class="fas fa-receipt"></i> Order Tracking</span>
                </div>
            </div>

            <div class="checkout-progress-card" aria-label="Checkout progress">
                <div class="checkout-step active">
                    <span><i class="fas fa-shopping-bag"></i></span>
                    <strong>Cart</strong>
                </div>
                <span class="checkout-step-line"></span>
                <div class="checkout-step active">
                    <span><i class="fas fa-truck"></i></span>
                    <strong>Delivery</strong>
                </div>
                <span class="checkout-step-line"></span>
                <div class="checkout-step active">
                    <span><i class="fas fa-credit-card"></i></span>
                    <strong>Payment</strong>
                </div>
            </div>
        </div>

        @if (items.Any())
        {
            <form asp-controller="Cart"
                  asp-action="Checkout"
                  method="post"
                  class="checkout-layout"
                  data-stripe-checkout
                  data-stripe-enabled="@stripeEnabledValue"
                  data-stripe-publishable-key="@publishableKey"
                  data-payment-intent-url="@paymentIntentUrl">
                @Html.AntiForgeryToken()
                <input asp-for="PaymentIntentId" type="hidden" data-payment-intent-id />

                <div class="checkout-main">
                    <section class="checkout-panel store-fade-in" style="animation-delay: 80ms">
                        <div class="checkout-panel-heading">
                            <span class="checkout-panel-icon"><i class="fas fa-truck"></i></span>
                            <div>
                                <h2>Delivery Information</h2>
                                <p>These two fields are used by the order service when creating your order.</p>
                            </div>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="checkout-validation"></div>

                        <div class="checkout-form-grid">
                            <div class="checkout-field">
                                <label asp-for="Phone">Phone Number</label>
                                <div class="checkout-input-wrap">
                                    <i class="fas fa-phone-alt"></i>
                                    <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="+20 100 000 0000" required />
                                </div>
                                <span asp-validation-for="Phone" class="checkout-field-error"></span>
                            </div>

                            <div class="checkout-field checkout-field-wide">
                                <label asp-for="Address">Delivery Address</label>
                                <div class="checkout-input-wrap">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <input asp-for="Address" type="text" autocomplete="street-address" placeholder="Street, building, apartment, city" required />
                                </div>
                                <span asp-validation-for="Address" class="checkout-field-error"></span>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-panel checkout-methods checkout-payment-panel store-fade-in" style="animation-delay: 150ms">
                        <div class="checkout-panel-heading">
                            <span class="checkout-panel-icon"><i class="fab fa-stripe-s"></i></span>
                            <div>
                                <h2>Payment Method</h2>
                                <p>Pay securely with Stripe, then your order will be saved to your customer account.</p>
                            </div>
                        </div>

                        <div class="checkout-method-grid">
                            <label class="checkout-method">
                                <input type="radio" name="PaymentMethod" value="stripe" checked />
                                <span><i class="fas fa-credit-card"></i></span>
                                <strong>Stripe Card</strong>
                                <small>Encrypted card payment</small>
                            </label>

                            <a asp-controller="Orders" asp-action="MyOrders" class="checkout-method checkout-method-link">
                                <span><i class="fas fa-receipt"></i></span>
                                <strong>My Orders</strong>
                                <small>View previous orders</small>
                            </a>
                        </div>

                        <div class="stripe-payment-card" data-stripe-payment-card>
                            <div class="stripe-payment-card-heading">
                                <div>
                                    <span class="section-eyebrow"><i class="fas fa-shield-alt"></i> Card Details</span>
                                    <h3>Secure card payment</h3>
                                </div>
                                <span class="stripe-mode-badge">Stripe</span>
                            </div>

                            @if (stripeConfigured)
                            {
                                <div class="stripe-elements-grid" data-stripe-elements>
                                    <div class="stripe-element-field stripe-element-field-wide">
                                        <label for="stripe-card-number">
                                            <i class="fas fa-credit-card"></i>
                                            Card number
                                        </label>
                                        <div id="stripe-card-number"
                                             class="stripe-card-shell"
                                             data-stripe-card-number
                                             aria-label="Card number"></div>
                                    </div>

                                    <div class="stripe-element-field">
                                        <label for="stripe-card-expiry">
                                            <i class="fas fa-calendar-alt"></i>
                                            Expiry
                                        </label>
                                        <div id="stripe-card-expiry"
                                             class="stripe-card-shell"
                                             data-stripe-card-expiry
                                             aria-label="Card expiry date"></div>
                                    </div>

                                    <div class="stripe-element-field">
                                        <label for="stripe-card-cvc">
                                            <i class="fas fa-lock"></i>
                                            CVC
                                        </label>
                                        <div id="stripe-card-cvc"
                                             class="stripe-card-shell"
                                             data-stripe-card-cvc
                                             aria-label="Card CVC"></div>
                                    </div>
                                </div>
                                <div class="payment-card-errors" data-stripe-errors role="alert" aria-live="polite"></div>
                            }
                            else
                            {
                                <div class="payment-config-warning">
                                    <i class="fas fa-key"></i>
                                    <div>
                                        <strong>Stripe keys are not configured yet.</strong>
                                        <span>Add your publishable and secret keys in User Secrets to enable card payment.</span>
                                    </div>
                                </div>
                            }

                            <div class="payment-security-grid" aria-label="Payment security">
                                <span><i class="fas fa-lock"></i> PCI-ready flow</span>
                                <span><i class="fas fa-bolt"></i> Instant confirmation</span>
                                <span><i class="fas fa-receipt"></i> Order saved after payment</span>
                            </div>
                        </div>
                    </section>
                </div>

                <aside class="checkout-summary store-fade-in" style="animation-delay: 220ms">
                    <div class="checkout-summary-header">
                        <div>
                            <span class="section-eyebrow"><i class="fas fa-receipt"></i> Order Summary</span>
                            <h2>@totalItems item@(totalItems == 1 ? string.Empty : "s")</h2>
                        </div>
                        <a asp-controller="Cart" asp-action="Index" class="checkout-edit-link">
                            <i class="fas fa-pen"></i>
                            <span>Edit</span>
                        </a>
                    </div>

                    <div class="checkout-item-list">
                        @foreach (var item in items)
                        {
                            var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl)
                                ? null
                                : Url.Content($"~/{item.ImageUrl.TrimStart('/')}");

                            <article class="checkout-item">
                                <div class="checkout-item-media">
                                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                                    {
                                        <img src="@imageUrl" alt="@item.ProductName" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="placeholder-illustration compact" aria-hidden="true">
                                            <span class="placeholder-screen"></span>
                                            <span class="placeholder-base"></span>
                                            <span class="placeholder-spark one"></span>
                                            <span class="placeholder-spark two"></span>
                                        </span>
                                    }
                                </div>

                                <div class="checkout-item-info">
                                    <h3>@item.ProductName</h3>
                                    <span>Qty @item.Quantity x @item.Price.ToString("C")</span>
                                </div>

                                <strong>@item.TotalPrice.ToString("C")</strong>
                            </article>
                        }
                    </div>

                    <div class="cart-summary-row">
                        <span>Subtotal</span>
                        <strong>@subtotal.ToString("C")</strong>
                    </div>
                    <div class="cart-summary-row">
                        <span>Shipping</span>
                        <strong>@(shipping == 0 ? "Free" : shipping.ToString("C"))</strong>
                    </div>
                    <div class="cart-summary-row cart-summary-total">
                        <span>Total</span>
                        <strong>@total.ToString("C")</strong>
                    </div>

                    <div class="cart-summary-actions">
                        <button type="submit" class="store-button-primary cart-checkout-button" data-stripe-submit>
                            <i class="fas fa-lock"></i>
                            <span>@(stripeConfigured ? "Pay Securely" : "Place Order")</span>
                        </button>
                        <a asp-controller="Store" asp-action="Index" class="store-button-secondary">
                            <i class="fas fa-store"></i>
                            <span>Continue Shopping</span>
                        </a>
                    </div>

                    <div class="checkout-secure-note">
                        <i class="fas fa-shield-alt"></i>
                        <span>@(stripeConfigured ? "Your card is handled by Stripe and your order is created after payment succeeds." : "Your order will be linked to your customer account.")</span>
                    </div>
                </aside>
            </form>
        }
        else
        {
            <div class="cart-empty">
                <span class="cart-empty-visual">
                    <i class="fas fa-shopping-bag"></i>
                </span>
                <h2>Your cart is empty</h2>
                <p>Add products to your cart before starting checkout.</p>
                <a asp-controller="Store" asp-action="Index" class="store-button-primary mt-3">
                    <i class="fas fa-store"></i>
                    <span>Browse Products</span>
                </a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
