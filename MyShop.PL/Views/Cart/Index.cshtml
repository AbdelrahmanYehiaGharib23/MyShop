@model MyShop.PL.ViewModels.CartViewModel

@{
    Layout = "~/Views/Shared/_Customer.cshtml";
    ViewData["Title"] = "Shopping Cart";

    var items = Model?.Items ?? new List<MyShop.DAL.Entities.CartItem>();
    var totalItems = Model?.TotalItems ?? 0;
    var totalPrice = Model?.TotalPrice ?? 0m;
}

<section class="cart-page">
    <div class="store-container">
        <div class="cart-page-heading">
            <div>
                <span class="section-eyebrow"><i class="fas fa-shopping-bag"></i> Shopping Cart</span>
                <h2>Your Cart</h2>
                <p>Review your selected products before checkout.</p>
            </div>
            <a asp-controller="Store" asp-action="Index" class="store-button-secondary">
                <i class="fas fa-arrow-left"></i>
                <span>Continue Shopping</span>
            </a>
        </div>

        @if (items.Any())
        {
            <div class="cart-layout">
                <div class="cart-list">
                    @foreach (var item in items)
                    {
                        var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl)
                            ? null
                            : Url.Content($"~/{item.ImageUrl.TrimStart('/')}");

                        <article class="cart-item">
                            <div class="cart-item-media">
                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl" alt="@item.ProductName" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <div class="cart-image-fallback">
                                        <span class="placeholder-illustration compact" aria-hidden="true">
                                            <span class="placeholder-screen"></span>
                                            <span class="placeholder-base"></span>
                                            <span class="placeholder-spark one"></span>
                                            <span class="placeholder-spark two"></span>
                                        </span>
                                    </div>
                                }
                            </div>

                            <div>
                                <h3>@item.ProductName</h3>
                                <div class="cart-item-meta">
                                    <span>Unit price: @item.Price.ToString("C")</span>
                                    <span>Product #@item.ProductId</span>
                                </div>
                                <div class="cart-quantity-tools">
                                    <form asp-controller="Cart" asp-action="Decrease" method="post" class="m-0">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="cart-quantity-button" aria-label="Decrease quantity">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </form>

                                    <span class="cart-quantity-value">@item.Quantity</span>

                                    <form asp-controller="Cart" asp-action="Increase" method="post" class="m-0">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="cart-quantity-button" aria-label="Increase quantity">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </form>

                                    <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="cart-remove-button" aria-label="Remove item">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div class="cart-item-total">
                                <span>Line total</span>
                                <strong>@item.TotalPrice.ToString("C")</strong>
                            </div>
                        </article>
                    }
                </div>

                <aside class="cart-summary">
                    <h3>Order Summary</h3>
                    <div class="cart-coupon">
                        <label class="visually-hidden" for="couponCode">Coupon code</label>
                        <input id="couponCode" type="text" placeholder="Coupon code" autocomplete="off" />
                        <button type="button">Apply</button>
                    </div>
                    <div class="cart-summary-row">
                        <span>Total items</span>
                        <strong>@totalItems</strong>
                    </div>
                    <div class="cart-summary-row">
                        <span>Subtotal</span>
                        <strong>@totalPrice.ToString("C")</strong>
                    </div>
                    <div class="cart-summary-row">
                        <span>Shipping</span>
                        <strong>Calculated later</strong>
                    </div>
                    <div class="cart-summary-row cart-summary-total">
                        <span>Total</span>
                        <strong>@totalPrice.ToString("C")</strong>
                    </div>

                    <div class="cart-summary-actions">
                        <button type="button" class="store-button-primary cart-checkout-button">
                            <i class="fas fa-lock"></i>
                            <span>Secure Checkout</span>
                        </button>
                        <a asp-controller="Store" asp-action="Index" class="store-button-secondary">
                            <i class="fas fa-store"></i>
                            <span>Keep Shopping</span>
                        </a>
                        <form asp-controller="Cart" asp-action="Clear" method="post" class="m-0">
                            <button type="submit" class="store-button-ghost">
                                <i class="fas fa-broom"></i>
                                <span>Clear Cart</span>
                            </button>
                        </form>
                    </div>
                </aside>
            </div>
        }
        else
        {
            <div class="cart-empty">
                <span class="cart-empty-visual">
                    <i class="fas fa-shopping-bag"></i>
                </span>
                <h2>Your cart is empty</h2>
                <p>Products you add to the cart will appear here with quantity, price, and order summary.</p>
                <a asp-controller="Store" asp-action="Index" class="store-button-primary mt-3">
                    <i class="fas fa-store"></i>
                    <span>Browse Products</span>
                </a>
            </div>
        }
    </div>
</section>
