@using MyShop.BLL.Models.Dto.ProductDto
@model IEnumerable<ProductDto>

@{
    var products = (Model ?? Enumerable.Empty<ProductDto>()).ToList();
    var categories = products
        .Select(product => product.CategoryName)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct()
        .OrderBy(category => category, StringComparer.OrdinalIgnoreCase)
        .ToList();

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Products";
    ViewBag.HideContentHeader = true;
    ViewBag.UseAdminCard = false;
}

<partial name="PartialView/_ProductStyles" />

<section class="product-shell">
    @if (TempData["Message"] is not null)
    {
        <div class="product-alert">
            <i class="fas fa-info-circle"></i>
            <span>@TempData["Message"]</span>
        </div>
    }

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="product-alert success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="product-toolbar">
        <div>
            <span class="product-kicker">Store inventory</span>
            <h2>Products</h2>
            <p>Manage product presentation, pricing, images, and category placement.</p>
        </div>
        <div class="product-toolbar-actions">
            <a asp-action="DeletedProducts" class="product-secondary-action">
                <i class="fas fa-trash-restore"></i>
                <span>Deleted Products</span>
            </a>
            <a asp-action="Create" class="product-primary-action">
                <i class="fas fa-plus"></i>
                <span>New Product</span>
            </a>
        </div>
    </div>

    <div class="product-metrics">
        <div class="product-metric">
            <span class="product-metric-icon" aria-hidden="true"><i class="fas fa-boxes"></i></span>
            <div class="product-metric-copy">
                <span>Total products</span>
                <strong>@products.Count</strong>
            </div>
        </div>
        <div class="product-metric">
            <span class="product-metric-icon" aria-hidden="true"><i class="fas fa-tags"></i></span>
            <div class="product-metric-copy">
                <span>Categories in use</span>
                <strong>@categories.Count</strong>
            </div>
        </div>
        <div class="product-metric">
            <span class="product-metric-icon" aria-hidden="true"><i class="fas fa-chart-line"></i></span>
            <div class="product-metric-copy">
                <span>Average price</span>
                <strong>@(products.Any() ? CurrencyFormatter.ToEgp(products.Average(product => product.Price)) : CurrencyFormatter.ToEgp(0))</strong>
            </div>
        </div>
    </div>

    @if (products.Any())
    {
        <div class="product-filters" data-product-filters>
            <label class="product-search-field">
                <span class="sr-only">Search products by name</span>
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" data-product-search placeholder="Search products..." autocomplete="off" />
            </label>
            <label class="product-select-field">
                <span class="sr-only">Filter by category</span>
                <select data-product-category>
                    <option value="">All categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
            <label class="product-select-field">
                <span class="sr-only">Sort products</span>
                <select data-product-sort>
                    <option value="default">Default order</option>
                    <option value="name-asc">Name: A to Z</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                </select>
            </label>
        </div>
        <p class="product-results-summary" data-product-results aria-live="polite"></p>

        <div class="product-grid" data-product-grid>
            @foreach (var product in products)
            {
                var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl)
                    ? null
                    : Url.Content($"~/{product.ImageUrl.TrimStart('/')}");

                <article class="product-card"
                         data-product-card
                         data-product-name="@product.Name"
                         data-product-category="@product.CategoryName"
                         data-product-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="product-card-media">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img src="@imageUrl" alt="@product.Name" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <div class="product-image-fallback">
                                <i class="fas fa-image"></i>
                            </div>
                        }
                        <span class="product-category-pill">@product.CategoryName</span>
                    </div>

                    <div class="product-card-body">
                        <h3>@product.Name</h3>
                        <div class="product-card-meta">
                            <strong>@CurrencyFormatter.ToEgp(product.Price)</strong>
                        </div>
                        <div class="product-card-actions">
                            <a asp-action="Details" asp-route-id="@product.Id" class="product-secondary-action">
                                <i class="fas fa-eye"></i>
                                <span>Details</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="product-secondary-action">
                                <i class="fas fa-edit"></i>
                                <span>Edit</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="product-danger-link">
                                <i class="fas fa-trash"></i>
                                <span>Delete</span>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
        <div class="product-filter-empty" data-product-empty hidden>
            <i class="fas fa-search" aria-hidden="true"></i>
            <p>No products match these filters.</p>
            <button class="product-filter-reset" type="button" data-product-reset>Clear filters</button>
        </div>
    }
    else
    {
        <div class="product-empty">
            <i class="fas fa-box-open"></i>
            <h3>No products yet</h3>
            <p>Add the first product and start shaping the storefront experience.</p>
            <a asp-action="Create" class="product-primary-action">
                <i class="fas fa-plus"></i>
                <span>Create Product</span>
            </a>
        </div>
    }
</section>

@section Scripts {
    <script>
        (function () {
            var filters = document.querySelector('[data-product-filters]');
            var grid = document.querySelector('[data-product-grid]');
            if (!filters || !grid) return;

            var search = filters.querySelector('[data-product-search]');
            var category = filters.querySelector('[data-product-category]');
            var sort = filters.querySelector('[data-product-sort]');
            var summary = document.querySelector('[data-product-results]');
            var empty = document.querySelector('[data-product-empty]');
            var reset = document.querySelector('[data-product-reset]');
            var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-product-card]'));
            var total = cards.length;
            cards.forEach(function (card, index) {
                card.dataset.productOrder = String(index);
            });

            function updateProducts() {
                var query = (search.value || '').trim().toLocaleLowerCase();
                var selectedCategory = category.value;
                var sortBy = sort.value;
                var visibleCount = 0;

                cards.sort(function (left, right) {
                    if (sortBy === 'name-asc') {
                        return left.dataset.productName.localeCompare(right.dataset.productName);
                    }
                    if (sortBy === 'price-asc') {
                        return Number(left.dataset.productPrice) - Number(right.dataset.productPrice);
                    }
                    if (sortBy === 'price-desc') {
                        return Number(right.dataset.productPrice) - Number(left.dataset.productPrice);
                    }
                    return Number(left.dataset.productOrder) - Number(right.dataset.productOrder);
                });

                cards.forEach(function (card) {
                    var matchesName = card.dataset.productName.toLocaleLowerCase().includes(query);
                    var matchesCategory = !selectedCategory || card.dataset.productCategory === selectedCategory;
                    var matches = matchesName && matchesCategory;
                    card.hidden = !matches;
                    if (matches) visibleCount++;
                    grid.appendChild(card);
                });

                summary.textContent = 'Showing ' + visibleCount + ' of ' + total + ' products';
                empty.hidden = visibleCount !== 0;
            }

            search.addEventListener('input', updateProducts);
            category.addEventListener('change', updateProducts);
            sort.addEventListener('change', updateProducts);
            reset.addEventListener('click', function () {
                search.value = '';
                category.value = '';
                sort.value = 'default';
                updateProducts();
                search.focus();
            });

            updateProducts();
        })();
    </script>
}
