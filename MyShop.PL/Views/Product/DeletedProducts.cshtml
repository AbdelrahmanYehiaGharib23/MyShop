@model IEnumerable<MyShop.PL.ViewModels.DeletedProductVM>

@{
    var products = (Model ?? Enumerable.Empty<MyShop.PL.ViewModels.DeletedProductVM>()).ToList();
    var totalValue = products.Sum(product => product.Price);
    var lastDeleted = products
        .Where(product => product.DeletedAt.HasValue)
        .OrderByDescending(product => product.DeletedAt)
        .FirstOrDefault();

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Deleted Products";
    ViewBag.PageTitle = "Product Management";
    ViewBag.CardTitle = "Deleted Products";
}

<partial name="PartialView/_ProductStyles" />

<style>
    .deleted-product-card {
        border-color: rgba(251, 113, 133, .28);
        background:
            radial-gradient(circle at 100% 0, rgba(251, 113, 133, .12), transparent 30%),
            var(--admin-surface);
    }

    .deleted-product-card .product-card-media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, .08), rgba(15, 23, 42, .56));
        pointer-events: none;
    }

    .deleted-product-badge {
        position: absolute;
        left: 12px;
        bottom: 12px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        max-width: calc(100% - 24px);
        padding: 6px 10px;
        border-radius: 999px;
        color: var(--admin-danger-soft-text);
        background: rgba(225, 29, 72, .24);
        border: 1px solid rgba(251, 113, 133, .35);
        font-size: 12px;
        font-weight: 800;
    }

    .deleted-product-meta {
        display: grid;
        gap: 9px;
        margin: 12px 0 16px;
        padding: 12px;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        background: var(--admin-page);
    }

    .deleted-product-meta span {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: var(--admin-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .deleted-product-meta strong {
        color: var(--admin-text-strong);
        font-weight: 800;
        text-align: right;
    }

    .deleted-product-description {
        min-height: 42px;
        margin: 0;
        color: var(--admin-muted);
        font-size: 13px;
        line-height: 1.6;
    }

    .deleted-product-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 9px;
    }
</style>

<section class="product-shell">
    <div class="product-toolbar">
        <div>
            <span class="product-kicker">Recycle Bin</span>
            <h2>Deleted Products</h2>
            <p>Review soft-deleted products and restore any item back to the active catalog.</p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="product-secondary-action">
            <i class="fas fa-arrow-left"></i>
            <span>Active Products</span>
        </a>
    </div>

    <div class="product-metrics">
        <div>
            <span>Deleted products</span>
            <strong>@products.Count</strong>
        </div>
        <div>
            <span>Deleted value</span>
            <strong>@CurrencyFormatter.ToEgp(totalValue)</strong>
        </div>
        <div>
            <span>Last deleted</span>
            <strong>@(lastDeleted?.DeletedAt?.ToString("MMM dd, yyyy") ?? "None")</strong>
        </div>
    </div>

    @if (products.Any())
    {
        <div class="product-grid">
            @foreach (var product in products)
            {
                var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl)
                    ? null
                    : Url.Content($"~/{product.ImageUrl.TrimStart('/')}");

                <article class="product-card deleted-product-card">
                    <div class="product-card-media">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img src="@imageUrl" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="product-image-fallback">
                                <i class="fas fa-image"></i>
                            </div>
                        }
                        <span class="deleted-product-badge">
                            <i class="fas fa-trash-alt"></i>
                            Deleted
                        </span>
                    </div>

                    <div class="product-card-body">
                        <h3>@product.Name</h3>
                        <div class="product-card-meta">
                            <strong>@CurrencyFormatter.ToEgp(product.Price)</strong>
                            <span>#@product.Id</span>
                        </div>

                        <p class="deleted-product-description">
                            @(string.IsNullOrWhiteSpace(product.Description)
                                ? "No product description was provided."
                                : product.Description)
                        </p>

                        <div class="deleted-product-meta">
                            <span>
                                Deleted at
                                <strong>@(product.DeletedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "Unknown")</strong>
                            </span>
                            <span>
                                Deleted by
                                <strong>@(string.IsNullOrWhiteSpace(product.DeletedBy) ? "System" : product.DeletedBy)</strong>
                            </span>
                        </div>

                        <div class="deleted-product-actions">
                            <form asp-controller="Product" asp-action="Restore" asp-route-id="@product.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="product-primary-action w-100">
                                    <i class="fas fa-undo"></i>
                                    <span>Restore Product</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="product-empty">
            <i class="fas fa-trash-restore"></i>
            <h3>No deleted products</h3>
            <p>Your recycle bin is clean. Deleted products will appear here when you remove them from the catalog.</p>
            <a asp-controller="Product" asp-action="Index" class="product-primary-action">
                <i class="fas fa-box-open"></i>
                <span>Back to Products</span>
            </a>
        </div>
    }
</section>
