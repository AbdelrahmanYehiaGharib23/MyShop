<style>
    .catalog-shell {
        color: var(--admin-text);
    }

    .catalog-narrow {
        max-width: 860px;
        margin: 0 auto;
    }

    .catalog-toolbar,
    .catalog-form-heading,
    .catalog-danger-panel,
    .catalog-confirm-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .catalog-toolbar {
        padding: 4px 0 20px;
    }

    .catalog-toolbar h2,
    .catalog-form-heading h2,
    .catalog-danger-panel h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: var(--admin-text-strong);
    }

    .catalog-toolbar p,
    .catalog-form-heading p,
    .catalog-danger-panel p {
        margin: 6px 0 0;
        color: var(--admin-muted);
    }

    .catalog-kicker {
        display: block;
        color: var(--admin-primary);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .catalog-primary-action,
    .catalog-secondary-action,
    .catalog-danger-action,
    .catalog-icon-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        border-radius: 8px;
        border: 1px solid transparent;
        font-weight: 700;
        text-decoration: none;
        transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
    }

    .catalog-primary-action {
        padding: 0 16px;
        background: var(--admin-action);
        color: #fff;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .18);
    }

    .catalog-primary-action:hover {
        color: #fff;
        background: var(--admin-action-hover);
        transform: translateY(-1px);
    }

    .catalog-secondary-action {
        padding: 0 14px;
        background: var(--admin-surface-soft);
        color: var(--admin-text);
        border-color: var(--admin-border);
    }

    .catalog-secondary-action:hover {
        color: var(--admin-text-strong);
        background: var(--admin-surface-hover);
    }

    .catalog-danger-action {
        padding: 0 16px;
        background: var(--admin-badge-danger-bg);
        color: var(--admin-danger);
        border-color: var(--admin-badge-danger-bg);
    }

    .catalog-danger-action:hover {
        color: #fff;
        background: var(--admin-danger);
        border-color: var(--admin-danger);
    }

    .catalog-metrics {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .catalog-metric,
    .catalog-form-panel,
    .catalog-danger-panel,
    .catalog-empty,
    .catalog-table-wrap {
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        background: var(--admin-surface);
    }

    .catalog-metric {
        padding: 16px;
    }

    .catalog-metric span {
        display: block;
        color: var(--admin-muted);
        font-size: 13px;
    }

    .catalog-metric strong {
        display: block;
        margin-top: 6px;
        font-size: 28px;
        color: var(--admin-text-strong);
    }

    .catalog-table-wrap {
        overflow: hidden;
    }

    .catalog-table {
        width: 100%;
        border-collapse: collapse;
    }

    .catalog-table th {
        background: var(--admin-deep-surface);
        color: var(--admin-muted);
        font-size: 12px;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 14px 16px;
    }

    .catalog-table tbody tr {
        background: var(--admin-surface);
    }

    .catalog-table tbody tr:hover {
        background: var(--admin-surface-hover);
    }

    .catalog-table td {
        padding: 16px;
        border-top: 1px solid var(--admin-border);
        vertical-align: middle;
    }

    .category-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .category-avatar,
    .catalog-form-icon,
    .catalog-danger-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: var(--admin-accent-soft);
        color: var(--admin-primary);
        font-weight: 800;
    }

    .category-cell strong,
    .category-cell small {
        display: block;
    }

    .category-cell small {
        color: var(--admin-muted);
        margin-top: 2px;
    }

    .catalog-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--admin-success);
        background: rgba(16, 185, 129, .12);
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .catalog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .catalog-actions-col {
        text-align: right;
    }

    .catalog-icon-action {
        width: 38px;
        height: 38px;
        color: var(--admin-primary);
        background: rgba(56, 189, 248, .12);
    }

    .catalog-icon-action.danger {
        color: var(--admin-danger);
        background: var(--admin-badge-danger-bg);
    }

    .catalog-form-panel {
        padding: 22px;
    }

    .catalog-form {
        margin-top: 22px;
    }

    .catalog-field {
        margin-bottom: 18px;
    }

    .catalog-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--admin-text);
        font-weight: 700;
    }

    .catalog-input-shell {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        padding: 0 12px;
        background: var(--admin-page);
    }

    .catalog-input-shell i {
        color: var(--admin-primary);
    }

    .catalog-input-shell input,
    .catalog-field textarea {
        width: 100%;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        padding: 11px 12px;
        color: var(--admin-text);
        background: var(--admin-page);
        outline: none;
    }

    .catalog-input-shell input::placeholder,
    .catalog-field textarea::placeholder {
        color: var(--admin-muted-soft);
    }

    .catalog-input-shell:focus-within,
    .catalog-field textarea:focus {
        border-color: var(--admin-primary);
        box-shadow: 0 0 0 .15rem rgba(56, 189, 248, .12);
        background: var(--admin-deep-surface);
    }

    .catalog-input-shell input {
        border: 0;
        padding-left: 0;
    }

    .catalog-field textarea {
        resize: vertical;
    }

    .catalog-validation,
    .catalog-field span {
        color: var(--admin-danger);
        font-size: 13px;
    }

    .catalog-form-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding-top: 6px;
    }

    .catalog-danger-panel {
        align-items: flex-start;
        padding: 22px;
        border-color: rgba(244, 63, 94, .32);
        background: var(--admin-surface);
    }

    .catalog-danger-icon {
        flex: 0 0 auto;
        background: rgba(244, 63, 94, .14);
        color: var(--admin-danger);
    }

    .catalog-confirm-form {
        margin-top: 16px;
    }

    .catalog-empty {
        padding: 36px 24px;
        text-align: center;
    }

    .catalog-empty > i {
        color: var(--admin-primary);
        font-size: 34px;
        margin-bottom: 12px;
    }

    .catalog-empty h3 {
        margin: 0;
        color: var(--admin-text-strong);
        font-weight: 700;
    }

    .catalog-empty p {
        color: var(--admin-muted);
        margin: 8px 0 18px;
    }

    .catalog-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 8px;
        background: rgba(56, 189, 248, .12);
        color: var(--admin-primary);
        font-weight: 700;
    }

    .catalog-alert.success {
        color: var(--admin-success);
        background: rgba(16, 185, 129, .12);
    }

    @@media (max-width: 700px) {
        .catalog-toolbar,
        .catalog-form-heading,
        .catalog-confirm-row {
            align-items: stretch;
            flex-direction: column;
        }

        .catalog-metrics {
            grid-template-columns: 1fr;
        }

        .catalog-table-wrap {
            overflow-x: auto;
        }

        .catalog-table {
            min-width: 640px;
        }

        .catalog-primary-action,
        .catalog-secondary-action,
        .catalog-danger-action {
            width: 100%;
        }
    }
</style>
