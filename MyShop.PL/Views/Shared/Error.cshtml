@model MyShop.PL.ViewModels.Identity.ErrorViewModel
@{
    Layout = null;
    var notFound = Model.StatusCode == StatusCodes.Status404NotFound;
    var forbidden = Model.StatusCode == StatusCodes.Status403Forbidden;
    var title = notFound ? "Page not found" : forbidden ? "Access unavailable" : "Something went wrong";
    var message = notFound
        ? "We couldn’t find the page you requested. It may have moved or the address may be incorrect."
        : forbidden
            ? "You don’t have access to this page. Return to the store or sign in with the right account."
            : "We couldn’t complete that request. Please try again in a moment.";
}
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="dark" data-store-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#0b1120" />
    <title>@title - myShop</title>
    <link rel="icon" type="image/svg+xml" href="~/Images/myshop-mark.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer-store.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('myshop-theme');
                if (theme === 'light' || theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', theme);
                    document.documentElement.setAttribute('data-store-theme', theme);
                }
                var language = localStorage.getItem('myshop-language');
                if (language === 'ar') {
                    document.documentElement.lang = 'ar';
                    document.documentElement.dir = 'rtl';
                }
            } catch (_) { }
        })();
    </script>
</head>
<body>
    <main class="store-error-page" id="main-content">
        <section class="store-error-card" role="alert" aria-labelledby="store-error-title">
            <span class="store-error-icon" aria-hidden="true"><i class="fas @(notFound ? "fa-search" : forbidden ? "fa-lock" : "fa-circle-exclamation")"></i></span>
            <span class="section-eyebrow">myShop</span>
            <h1 id="store-error-title">@title</h1>
            <p>@message</p>
            @if (Model.ShowRequestId)
            {
                <p class="store-error-reference"><span>Reference</span> <code>@Model.RequestId</code></p>
            }
            <div class="store-error-actions">
                <a class="store-button-primary" asp-controller="Store" asp-action="Index"><i class="fas fa-store" aria-hidden="true"></i><span>Return to the store</span></a>
                <a class="store-button-secondary" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket" aria-hidden="true"></i><span>Sign in</span></a>
            </div>
        </section>
    </main>
    <script src="~/js/language.js" asp-append-version="true"></script>
</body>
</html>
