@*
    Layout => Auth (Register / Login)
*@
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MyShop Auth</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/Images/myshop-mark.svg" />
    <script>
        (function () {
            var saved = localStorage.getItem('myshop-theme');
            var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var valid = saved === 'dark' || saved === 'light';
            document.documentElement.setAttribute('data-theme', valid ? saved : (dark ? 'dark' : 'light'));
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css" />

    <!-- Auth CSS -->
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="stylesheet" href="/css/theme.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="~/css/auth-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive-mobile.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-wrapper">

        <!-- Theme Toggle Button -->
        <div class="theme-toggle">
            <button id="toggleTheme" type="button" data-theme-toggle aria-label="Switch theme" aria-pressed="true">
                <i class="fas fa-moon" aria-hidden="true"></i><span>Dark Mode</span>
            </button>
        </div>

        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="/js/theme.js"></script>
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
