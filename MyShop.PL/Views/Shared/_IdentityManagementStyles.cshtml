<style>
    .identity-shell {
        color: var(--admin-text);
    }

    .identity-form {
        max-width: 860px;
        margin: 0 auto;
    }

    .identity-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 4px 0 20px;
    }

    .identity-kicker {
        display: block;
        color: var(--admin-primary);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .identity-title,
    .identity-toolbar h2 {
        margin: 0;
        color: var(--admin-text-strong);
        font-size: 26px;
        font-weight: 700;
    }

    .identity-copy,
    .identity-toolbar p {
        margin: 6px 0 0;
        color: var(--admin-muted);
    }

    .identity-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .identity-stats:has(> .identity-stat:only-child) {
        grid-template-columns: minmax(0, 1fr);
    }

    .identity-stat,
    .identity-table-card,
    .identity-panel,
    .identity-empty {
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        background: var(--admin-surface);
    }

    .identity-stat {
        padding: 16px;
    }

    .identity-stat span {
        display: block;
        color: var(--admin-muted);
        font-size: 13px;
    }

    .identity-stat strong {
        display: block;
        margin-top: 6px;
        color: var(--admin-text-strong);
        font-size: 28px;
        font-weight: 800;
    }

    .identity-search {
        display: flex;
        gap: 10px;
        margin-bottom: 18px;
    }

    .identity-input,
    .identity-shell .form-control {
        min-height: 42px;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        color: var(--admin-text);
        background: var(--admin-page);
        box-shadow: none;
        outline: none;
    }

    .identity-input::placeholder,
    .identity-shell .form-control::placeholder {
        color: var(--admin-muted-soft);
    }

    .identity-input:focus,
    .identity-shell .form-control:focus {
        border-color: var(--admin-primary);
        background: var(--admin-deep-surface);
        color: var(--admin-text);
        box-shadow: 0 0 0 .15rem rgba(56, 189, 248, .12);
    }

    .identity-primary-action,
    .identity-secondary-action,
    .identity-danger-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        border-radius: 8px;
        border: 1px solid transparent;
        padding: 0 16px;
        font-weight: 700;
        text-decoration: none;
        transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
    }

    .identity-primary-action {
        color: #fff;
        background: var(--admin-action);
        box-shadow: 0 5px 14px rgba(37, 99, 235, .18);
    }

    .identity-primary-action:hover {
        color: #fff;
        background: var(--admin-action-hover);
        transform: translateY(-1px);
    }

    .identity-secondary-action {
        color: var(--admin-text);
        background: var(--admin-surface-soft);
        border-color: var(--admin-border);
    }

    .identity-secondary-action:hover {
        color: var(--admin-text-strong);
        background: var(--admin-surface-hover);
    }

    .identity-danger-action {
        color: var(--admin-danger);
        background: var(--admin-badge-danger-bg);
        border-color: var(--admin-badge-danger-bg);
    }

    .identity-danger-action:hover {
        color: #fff;
        background: var(--admin-danger);
        border-color: var(--admin-danger);
    }

    .identity-table-card {
        overflow: hidden;
    }

    .identity-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        color: var(--admin-text);
    }

    .identity-table thead th {
        border: 0;
        background: var(--admin-deep-surface);
        color: var(--admin-muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 14px 16px;
    }

    .identity-table tbody tr {
        background: var(--admin-surface);
    }

    .identity-table tbody tr:hover {
        background: var(--admin-surface-hover);
    }

    .identity-table tbody td {
        border-top: 1px solid var(--admin-border);
        padding: 16px;
        vertical-align: middle;
    }

    .identity-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .identity-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 8px;
        color: var(--admin-primary);
        background: var(--admin-accent-soft);
        font-weight: 800;
    }

    .identity-name-cell strong,
    .identity-name-cell small {
        display: block;
    }

    .identity-name-cell strong {
        color: var(--admin-text-strong);
        font-weight: 800;
    }

    .identity-name-cell small {
        margin-top: 2px;
        color: var(--admin-muted);
    }

    .identity-badge-list,
    .identity-action-group {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .identity-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        color: var(--admin-success);
        background: rgba(16, 185, 129, .12);
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .identity-action-group.justify-content-end {
        justify-content: flex-end;
    }

    .identity-table .identity-secondary-action,
    .identity-table .identity-danger-action {
        min-height: 38px;
        padding: 0 12px;
        font-size: 13px;
    }

    .identity-empty {
        padding: 36px 24px;
        color: var(--admin-muted);
        text-align: center;
    }

    .identity-empty i {
        display: block;
        margin-bottom: 12px;
        color: var(--admin-primary);
        font-size: 34px;
    }

    .identity-empty strong {
        color: var(--admin-text-strong);
        font-size: 18px;
    }

    .identity-panel {
        padding: 22px;
    }

    .identity-form-grid,
    .identity-readonly-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
    }

    .identity-form label,
    .identity-readonly-label {
        display: block;
        margin-bottom: 8px;
        color: var(--admin-text);
        font-weight: 700;
    }

    .identity-readonly-value {
        min-height: 42px;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        background: var(--admin-page);
        padding: 11px 12px;
        color: var(--admin-text);
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .identity-role-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 14px;
    }

    .identity-role-option {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        background: var(--admin-surface);
        padding: 14px;
        color: var(--admin-text);
        font-weight: 700;
    }

    .identity-role-option input {
        width: 18px;
        height: 18px;
        accent-color: var(--admin-primary);
    }

    .identity-shell .text-danger,
    .identity-shell .field-validation-error,
    .identity-shell [data-valmsg-for] {
        color: var(--admin-danger) !important;
        font-size: 13px;
    }

    @@media (max-width: 860px) {
        .identity-toolbar,
        .identity-action-group {
            align-items: stretch;
            flex-direction: column;
        }

        .identity-search {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .identity-search .identity-input {
            grid-column: 1 / -1;
            width: 100%;
        }

        .identity-table-card {
            overflow-x: auto;
        }

        .identity-table {
            min-width: 760px;
        }

        .identity-primary-action,
        .identity-secondary-action,
        .identity-danger-action {
            width: 100%;
        }

        .identity-search :is(.identity-primary-action, .identity-secondary-action) {
            min-height: 44px;
            justify-content: center;
        }
    }
</style>
