@{
    var pageTitle = ViewData["Title"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var roleName = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Customer") ? "Customer":"Customer";
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "myShop Admin" : $"{pageTitle} - myShop Admin")</title>
    <link rel="icon" type="image/svg+xml" href="~/Images/myshop-mark.svg" asp-append-version="true" />

    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('myshop-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var theme = savedTheme === 'dark' || savedTheme === 'light'
                    ? savedTheme
                    : (prefersDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.classList.toggle(
                    'admin-sidebar-collapsed',
                    localStorage.getItem('myshop-admin-sidebar') === 'collapsed');
            } catch { }
        })();
    </script>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/css/adminlte.min.css">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <link rel="stylesheet" href="//cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <style>
        html {
            scrollbar-gutter: stable;
            scroll-behavior: auto;
        }

        .main-sidebar {
            display: flex;
            flex-direction: column;
            height: 100vh;
            min-height: 100vh;
            background: linear-gradient(180deg, var(--admin-sidebar-deep) 0%, var(--admin-sidebar) 46%, var(--admin-sidebar-soft) 100%);
        }

        .main-sidebar .sidebar {
            flex: 1 1 auto;
            min-height: 0;
            height: auto;
        }

        .brand-link {
            min-height: 64px;
            background: rgba(18, 26, 34, .96);
            border-bottom: 1px solid rgba(255, 255, 255, .1);
            color: #fff;
            font-weight: 700;
        }

        .brand-link:hover {
            color: #fff;
        }

        .brand-text {
            letter-spacing: 0;
        }

        .main-header {
            border-bottom: 1px solid var(--admin-border);
        }

        .admin-navbar-title {
            color: var(--admin-ink);
            font-weight: 700;
        }

        .admin-navbar-subtitle {
            color: var(--admin-muted);
            font-size: 12px;
            font-weight: 500;
        }

        .admin-user-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--admin-ink);
            font-weight: 600;
        }

        .admin-user-chip i {
            color: var(--admin-accent);
        }

        .user-panel img {
            border: 2px solid white;
        }

        .sidebar-account-panel {
            border-top: 1px solid var(--sidebar-panel-border);
        }

        .sidebar-account-card {
            background: var(--sidebar-panel-bg);
            border: 1px solid var(--sidebar-panel-border);
            border-radius: 8px;
            padding: 14px;
            backdrop-filter: blur(6px);
        }

        .sidebar-account-avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .sidebar-account-status-dot {
            position: absolute;
            bottom: 1px;
            right: 1px;
            width: 10px;
            height: 10px;
            background: #27c77b;
            border: 2px solid #14213d;
            border-radius: 50%;
        }

        .sidebar-account-name {
            max-width: 140px;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.2;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .sidebar-account-role {
            color: var(--sidebar-text-dim);
            font-size: 12px;
        }

        .sidebar-logout-divider {
            border: none;
            border-top: 1px solid var(--sidebar-panel-border);
            margin: 12px 0;
        }

        .btn-logout,
        .btn-login-sidebar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            transition: .2s ease;
        }

        .btn-logout {
            color: #ff6b6b;
            background: rgba(255, 107, 107, .08);
            border: 1px solid rgba(255, 107, 107, .35);
        }

        .btn-logout:hover,
        .btn-logout:focus {
            background: #ff6b6b;
            border-color: #ff6b6b;
            color: #fff;
            box-shadow: 0 4px 12px rgba(255, 107, 107, .28);
        }

        .btn-login-sidebar {
            color: var(--admin-accent);
            background: rgba(15, 159, 143, .1);
            border: 1px solid rgba(15, 159, 143, .35);
        }

        .btn-login-sidebar:hover,
        .btn-login-sidebar:focus {
            background: var(--admin-accent);
            border-color: var(--admin-accent);
            color: #fff;
            box-shadow: 0 4px 12px rgba(15, 159, 143, .26);
        }

        .sidebar-collapse .sidebar-account-panel {
            padding: .5rem !important;
        }

        .sidebar-collapse .sidebar-account-card {
            padding: 8px 4px;
            background: transparent;
            border: none;
        }

        .sidebar-collapse .sidebar-account-card .d-flex.align-items-center {
            justify-content: center;
        }

        .sidebar-collapse .sidebar-account-avatar-wrap img {
            width: 34px;
            height: 34px;
        }

        .sidebar-collapse .sidebar-account-card .ml-3,
        .sidebar-collapse .sidebar-logout-divider,
        .sidebar-collapse .btn-logout span,
        .sidebar-collapse .btn-login-sidebar span {
            display: none;
        }

        .sidebar-collapse .btn-logout,
        .sidebar-collapse .btn-login-sidebar {
            width: 34px;
            height: 34px;
            padding: 0;
            margin: 8px auto 0;
            border-radius: 50%;
        }
    </style>
    <link rel="stylesheet" href="~/css/admin-polish.css" asp-append-version="true">
    <style>
        body.hold-transition .wrapper,
        body.hold-transition .main-sidebar > .sidebar,
        body.hold-transition .content,
        body.hold-transition .admin-nav-link {
            transition: none !important;
        }

        body.hold-transition .main-header,
        body.hold-transition .main-sidebar,
        body.hold-transition .content-wrapper,
        body.hold-transition .main-footer {
            transition: width .18s ease, margin-left .18s ease, transform .18s ease, background-color .18s ease !important;
        }

        body.hold-transition .main-sidebar {
            width: 250px !important;
        }

        body.hold-transition .main-header,
        body.hold-transition .content-wrapper,
        body.hold-transition .main-footer {
            margin-left: 250px !important;
        }

        body.hold-transition .main-sidebar > .sidebar {
            background: var(--admin-sidebar, #101a2c) !important;
            color: var(--admin-text, #fff) !important;
        }

        body.hold-transition .admin-sidebar-nav {
            display: block !important;
            width: 100%;
            margin: 0 !important;
            padding: 10px 8px 16px;
        }

        body.hold-transition .admin-nav-list {
            display: flex !important;
            flex-direction: column;
            gap: 5px;
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            list-style: none !important;
        }

        body.hold-transition .admin-nav-item {
            display: block !important;
            width: 100%;
            margin: 0;
            padding: 0;
            list-style: none !important;
        }

        body.hold-transition .admin-nav-item::marker {
            content: none;
        }

        body.hold-transition .admin-nav-link {
            display: flex !important;
            align-items: center;
            gap: 12px;
            width: 100%;
            min-height: 44px;
            margin: 0;
            padding: 10px 12px;
            border: 1px solid transparent;
            border-radius: 9px;
            background: transparent;
            color: var(--admin-muted, #fff) !important;
            text-decoration: none !important;
            transform: none !important;
            transition: none !important;
            cursor: pointer;
        }

        body.hold-transition .admin-nav-icon {
            flex: 0 0 20px;
            width: 20px;
            margin: 0;
            color: var(--admin-primary, #fff) !important;
            text-align: center;
        }

        body.hold-transition .admin-nav-label {
            display: block;
            color: inherit !important;
        }

        body.hold-transition .admin-sidebar-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
            min-height: 40px;
            padding: 8px;
            border: 1px solid var(--admin-border, #dce4ee);
            border-radius: 8px;
            background: var(--admin-surface, #fff) !important;
            color: var(--admin-text-strong, #fff) !important;
            box-shadow: none !important;
            cursor: pointer;
        }

        body.hold-transition .admin-sidebar-toggle:hover {
            background: var(--admin-surface-hover, #1b2b45) !important;
        }

        body.hold-transition .admin-nav-icon {
            color: #2563eb !important;
        }

        @@media (min-width: 768px) {
            html.admin-sidebar-collapsed body.hold-transition .main-sidebar {
                width: 76px !important;
            }

            html.admin-sidebar-collapsed body.hold-transition .main-header,
            html.admin-sidebar-collapsed body.hold-transition .content-wrapper,
            html.admin-sidebar-collapsed body.hold-transition .main-footer {
                margin-left: 76px !important;
            }

            html.admin-sidebar-collapsed body.hold-transition .brand-link {
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                padding-right: 0;
                padding-left: 0;
            }

            html.admin-sidebar-collapsed body.hold-transition .brand-link .brand-image {
                float: none;
                width: 34px;
                max-height: 34px;
                margin: 0;
            }

            html.admin-sidebar-collapsed body.hold-transition .brand-text,
            html.admin-sidebar-collapsed body.hold-transition .admin-nav-label,
            html.admin-sidebar-collapsed body.hold-transition .sidebar-account-name,
            html.admin-sidebar-collapsed body.hold-transition .sidebar-account-role,
            html.admin-sidebar-collapsed body.hold-transition .sidebar-logout-divider,
            html.admin-sidebar-collapsed body.hold-transition .btn-logout span,
            html.admin-sidebar-collapsed body.hold-transition .btn-login-sidebar span {
                display: none !important;
            }

            html.admin-sidebar-collapsed body.hold-transition .admin-sidebar-nav {
                padding-right: 8px;
                padding-left: 8px;
            }

            html.admin-sidebar-collapsed body.hold-transition .admin-nav-link {
                justify-content: center;
                gap: 0;
                padding-right: 0;
                padding-left: 0;
            }

            html.admin-sidebar-collapsed body.hold-transition .sidebar-account-panel {
                padding: 12px 8px !important;
            }

            html.admin-sidebar-collapsed body.hold-transition .sidebar-account-card {
                padding: 8px 4px;
            }

            html.admin-sidebar-collapsed body.hold-transition .sidebar-account-card .d-flex {
                justify-content: center;
            }

            html.admin-sidebar-collapsed body.hold-transition .sidebar-account-avatar-wrap img {
                width: 34px;
                height: 34px;
            }

            html.admin-sidebar-collapsed body.hold-transition .btn-logout,
            html.admin-sidebar-collapsed body.hold-transition .btn-login-sidebar {
                width: 40px;
                min-width: 40px;
                height: 40px;
                min-height: 40px;
                margin-right: auto;
                margin-left: auto;
                padding: 0;
            }
        }
        }

        html[data-theme="dark"] body.hold-transition .main-header.navbar,
        html[data-theme="dark"] body.hold-transition .main-sidebar,
        html[data-theme="dark"] body.hold-transition .main-sidebar > .sidebar,
        html[data-theme="dark"] body.hold-transition .brand-link,
        html[data-theme="dark"] body.hold-transition .sidebar-account-panel,
        html[data-theme="dark"] body.hold-transition .main-footer.admin-footer {
            background: #0b1220 !important;
            color: #fff !important;
            border-color: #2b3b57 !important;
        }

        html[data-theme="dark"] body.hold-transition .content-wrapper,
        html[data-theme="dark"] body.hold-transition .content {
            background: #0f172a !important;
            color: #fff !important;
        }

        html[data-theme="dark"] body.hold-transition .main-header .nav-link,
        html[data-theme="dark"] body.hold-transition .admin-navbar-title,
        html[data-theme="dark"] body.hold-transition .admin-navbar-subtitle,
        html[data-theme="dark"] body.hold-transition .admin-user-chip,
        html[data-theme="dark"] body.hold-transition .sidebar-account-name,
        html[data-theme="dark"] body.hold-transition .sidebar-account-role,
        html[data-theme="dark"] body.hold-transition .admin-nav-link,
        html[data-theme="dark"] body.hold-transition .admin-nav-icon {
            color: #fff !important;
        }

        html[data-theme="dark"] body.hold-transition .admin-nav-icon {
            color: #93c5fd !important;
        }

        html[data-theme="dark"] body.hold-transition .admin-nav-link:hover {
            background: #1b2b45 !important;
        }

        html[data-theme="dark"] body.hold-transition .admin-nav-link.active {
            background: #1a2d4b !important;
            border-left: 3px solid #60a5fa !important;
        }

        html[data-theme="dark"] body.hold-transition .content-wrapper .btn-outline-primary {
            color: #fff !important;
            border-color: #fff !important;
        }

        html[data-theme="light"] body.hold-transition .main-header.navbar,
        html[data-theme="light"] body.hold-transition .main-sidebar,
        html[data-theme="light"] body.hold-transition .main-sidebar > .sidebar,
        html[data-theme="light"] body.hold-transition .brand-link,
        html[data-theme="light"] body.hold-transition .sidebar-account-panel,
        html[data-theme="light"] body.hold-transition .main-footer.admin-footer {
            background: #fff !important;
            color: #0f172a !important;
            border-color: #dce4ee !important;
        }

        html[data-theme="light"] body.hold-transition .content-wrapper,
        html[data-theme="light"] body.hold-transition .content {
            background: #f4f7fb !important;
            color: #0f172a !important;
        }

        html[data-theme="light"] body.hold-transition .main-header .nav-link,
        html[data-theme="light"] body.hold-transition .admin-navbar-title,
        html[data-theme="light"] body.hold-transition .admin-navbar-subtitle,
        html[data-theme="light"] body.hold-transition .admin-user-chip,
        html[data-theme="light"] body.hold-transition .sidebar-account-name,
        html[data-theme="light"] body.hold-transition .sidebar-account-role,
        html[data-theme="light"] body.hold-transition .admin-nav-link,
        html[data-theme="light"] body.hold-transition .admin-nav-label {
            color: #0f172a !important;
        }

        html[data-theme="light"] body.hold-transition .admin-nav-icon {
            color: #2563eb !important;
        }

        html[data-theme="light"] body.hold-transition .admin-nav-link:hover {
            background: #edf3fa !important;
        }

        html[data-theme="light"] body.hold-transition .admin-nav-link.active {
            background: #e8f1ff !important;
            border-left: 3px solid #2563eb !important;
        }

        html[data-theme="light"] body.hold-transition .content-wrapper .btn-outline-primary {
            color: #0f172a !important;
            border-color: #0f172a !important;
        }

        @@media (max-width: 767.98px) {
            body.hold-transition .main-header,
            body.hold-transition .content-wrapper,
            body.hold-transition .main-footer {
                margin-left: 0 !important;
            }

            body.hold-transition .main-sidebar {
                z-index: 1040;
                width: 250px !important;
                transform: translateX(-100%);
                transition: transform .2s ease !important;
            }

            body.hold-transition.admin-sidebar-open .main-sidebar {
                transform: translateX(0);
            }

            body.hold-transition.admin-sidebar-open::before {
                position: fixed;
                z-index: 1039;
                inset: 0;
                background: rgba(2, 6, 23, .56);
                content: "";
            }
        }
    </style>
</head>


<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand shadow-sm">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <button type="button"
                            class="nav-link admin-sidebar-toggle"
                            data-admin-sidebar-toggle
                            aria-controls="admin-sidebar"
                            aria-expanded="true"
                            aria-label="Collapse navigation"
                            title="Collapse navigation">
                        <i class="fas fa-bars"></i>
                    </button>
                </li>
                <li class="nav-item d-none d-sm-flex flex-column justify-content-center ml-2">
                    <span class="admin-navbar-title">Admin Console</span>
                    <span class="admin-navbar-subtitle">Orders, catalog, and security management</span>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item d-none d-md-flex align-items-center pr-3">
                    <span class="admin-user-chip">
                        <i class="fas fa-user-circle"></i>
                        @(User.Identity?.Name ?? "Guest")
                    </span>
                </li>
                <li class="nav-item d-flex align-items-center">
                    <button type="button"
                            class="admin-theme-toggle"
                            data-theme-toggle
                            aria-label="Switch theme"
                            aria-pressed="true"
                            title="Switch light or dark mode">
                        <i class="fas fa-moon" aria-hidden="true"></i>
                        <span class="sr-only">Switch theme</span>
                    </button>
                </li>
            </ul>
        </nav>

        <aside id="admin-sidebar" class="main-sidebar elevation-4">
            <a asp-area="" asp-controller="Product" asp-action="Index" class="brand-link">
                <img src="~/img/AdminLTELogo.png"
                     class="brand-image img-circle elevation-3"
                     style="opacity:.9"
                     alt="myShop logo">
                <span class="brand-text">myShop Admin</span>
            </a>

            <div class="sidebar d-flex flex-column">
                <nav class="admin-sidebar-nav mt-3" aria-label="Admin navigation">
                    <ul class="admin-nav-list" style="list-style:none;margin:0;padding:0;">
                        <li class="admin-nav-item" style="list-style:none;margin:0;padding:0;">
                            <a title="Orders" asp-area="" asp-controller="OrderManagement"
                               asp-action="Index"
                               class="admin-nav-link @(string.Equals(currentController, "OrderManagement", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                                <i class="admin-nav-icon fas fa-receipt" aria-hidden="true"></i>
                                <span class="admin-nav-label">Orders</span>
                            </a>
                        </li>

                        <li class="admin-nav-item" style="list-style:none;margin:0;padding:0;">
                            <a title="Products" asp-area="" asp-controller="Product"
                               asp-action="Index"
                               class="admin-nav-link @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) && !string.Equals(currentAction, "DeletedProducts", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                                <i class="admin-nav-icon fas fa-box-open" aria-hidden="true"></i>
                                <span class="admin-nav-label">Products</span>
                            </a>
                        </li>

                        <li class="admin-nav-item" style="list-style:none;margin:0;padding:0;">
                            <a title="Categories" asp-controller="Category"
                               asp-area=""
                               asp-action="Index"
                               class="admin-nav-link @(string.Equals(currentController, "Category", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                                <i class="admin-nav-icon fas fa-tags" aria-hidden="true"></i>
                                <span class="admin-nav-label">Categories</span>
                            </a>
                        </li>

                        <li class="admin-nav-item" style="list-style:none;margin:0;padding:0;">
                            <a title="Deleted Products" asp-area=""
                               asp-controller="Product"
                               asp-action="DeletedProducts"
                               class="admin-nav-link @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "DeletedProducts", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                                <i class="admin-nav-icon fas fa-trash-restore" aria-hidden="true"></i>
                                <span class="admin-nav-label">Deleted Products</span>
                            </a>
                        </li>

                        <li class="admin-nav-item" style="list-style:none;margin:0;padding:0;">
                            <a title="Users" asp-area="" asp-controller="User"
                               asp-action="Index"
                               class="admin-nav-link @(string.Equals(currentController, "User", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                                <i class="admin-nav-icon fas fa-users" aria-hidden="true"></i>
                                <span class="admin-nav-label">Users</span>
                            </a>
                        </li>

                        <li class="admin-nav-item" style="list-style:none;margin:0;padding:0;">
                            <a title="Roles" asp-area="" asp-controller="Roles"
                               asp-action="Index"
                               class="admin-nav-link @(string.Equals(currentController, "Roles", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                                <i class="admin-nav-icon fas fa-user-shield" aria-hidden="true"></i>
                                <span class="admin-nav-label">Roles</span>
                            </a>
                        </li>
                    </ul>
                </nav>

            </div>

            <div class="p-3 sidebar-account-panel">
                <div class="sidebar-account-card">
                    <div class="d-flex align-items-center">
                        <div class="sidebar-account-avatar-wrap">
                            <img src="~/img/user2-160x160.jpg"
                                 class="img-circle elevation-2"
                                 width="42"
                                 height="42"
                                 alt="Admin user">
                            <span class="sidebar-account-status-dot" title="Online"></span>
                        </div>
                        <div class="ml-3">
                            <div class="sidebar-account-name">@(User.Identity?.Name ?? "Administrator")</div>
                            <div class="sidebar-account-role">@roleName account</div>
                        </div>
                    </div>

                    <hr class="sidebar-logout-divider">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout" title="Log out">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-login-sidebar" title="Log in">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Login</span>
                        </a>
                    }
                </div>
            </div>
        </aside>

        <div class="content-wrapper">
            <section class="content">
                <div class="container-fluid">
                    <partial name="_Toaster" />
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer admin-footer">
            <strong>&copy; @DateTime.Now.Year myShop.</strong>
            All rights reserved.
        </footer>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adminlte.min.js"></script>
    <script src="//cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
