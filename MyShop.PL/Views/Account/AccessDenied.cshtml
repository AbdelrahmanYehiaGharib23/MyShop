@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Access Denied";
}

<main class="auth-card auth-access-denied" aria-labelledby="accessDeniedTitle">
    <span class="auth-step-icon" aria-hidden="true">
        <i class="fas fa-lock"></i>
    </span>
    <span class="auth-access-code">403</span>
    <h1 class="auth-title" id="accessDeniedTitle">Access denied</h1>
    <p class="auth-subtitle">Your account doesn't have permission to view this page.</p>
    <div class="auth-access-actions">
        <a asp-controller="Store" asp-action="Index" class="auth-btn auth-access-primary">
            <i class="fas fa-store" aria-hidden="true"></i>
            <span>Return to Store</span>
        </a>
        <a asp-controller="Account" asp-action="Login" class="auth-access-secondary">
            <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
            <span>Sign in with another account</span>
        </a>
    </div>
</main>
