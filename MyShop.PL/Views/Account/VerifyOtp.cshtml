@using MyShop.BLL.Models.Dto.IdentityDto

@model VerifyOtpDto
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Verify OTP";
}

@section Styles {
    <link rel="stylesheet" href="~/css/otp-motion.css" asp-append-version="true" />
}

<div class="auth-card auth-verify-otp">
    <div class="auth-step-icon">
        <i class="fas fa-shield-alt" aria-hidden="true"></i>
    </div>

    <h2 class="auth-title">Verify OTP</h2>
    <p class="auth-subtitle">Use the code sent to your email to continue.</p>

    <form asp-action="VerifyOtp" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="input-group">
            <span class="input-icon"><i class="fas fa-envelope"></i></span>
            <label asp-for="Email" class="visually-hidden">Email address</label>
            <input asp-for="Email" placeholder="Email" required />
        </div>
        <span asp-validation-for="Email" class="field-validation-error"></span>

        <label asp-for="Otp" class="visually-hidden">Verification code</label>
        <div class="input-group otp-input-group">
            <div class="otp-motion" data-otp-motion>
                <div class="otp-boxes" aria-hidden="true"></div>
                <div class="otp-status" data-otp-status aria-live="polite" aria-atomic="true">
                    <span class="otp-status-spinner" aria-hidden="true"></span>
                    <span data-otp-status-text></span>
                </div>
                <input asp-for="Otp"
                       class="otp-native-input"
                       placeholder="OTP Code"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="6"
                       pattern="[0-9]{6}"
                       autocapitalize="off"
                       spellcheck="false"
                       required />
            </div>
        </div>
        <span asp-validation-for="Otp" class="field-validation-error"></span>

        <button type="submit" class="auth-btn">VERIFY OTP</button>
    </form>

    <p class="switch-form">Back to <a asp-action="ForgotPassword" asp-controller="Account">Forgot Password</a></p>
</div>

@section Scripts {
    <script src="~/js/otp-motion.js" asp-append-version="true"></script>
}
